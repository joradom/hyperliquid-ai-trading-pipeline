      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rule_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "field": {
              "type": "string",
              "enum": [
                "l2_midpoint",
                "best_bid",
                "best_ask",
                "spread_bps",
                "mark",
                "context_mid",
                "oracle",
                "premium",
                "daily_notional_volume",
                "funding_current",
                "open_interest",
                "orderbook_imbalance",
                "original_atr_5m",
                "original_atr_15m"
              ]
            },
            "predicate_type": {
              "type": "string",
              "enum": [
                "price_above",
                "price_below",
                "spread_lte",
                "funding_lte",
                "funding_gte",
                "oi_change_gte",
                "oi_change_lte",
                "imbalance_gte",
                "imbalance_lte",
                "max_price_displacement_atr"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "range": {
              "type": "null"
            },
            "reference_source": {
              "$ref": "#/$defs/reference"
            },
            "threshold_origin": {
              "type": "string",
              "enum": [
                "model_derived_from_snapshot",
                "pre_analysis_policy",
                "explicit_snapshot_level",
                "user_policy",
                "unsupported"
              ]
            },
            "derivation": {
              "type": "string",
              "enum": [
                "identity",
                "ordered_range",
                "snapshot_distance_atr"
              ]
            },
            "purpose": {
              "type": "string",
              "enum": [
                "entry",
                "invalidation",
                "quality"
              ]
            },
            "required_for_valid": {
              "type": "boolean"
            },
            "baseline_field": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open_interest",
                    "l2_midpoint",
                    "best_bid",
                    "best_ask",
                    "mark",
                    "context_mid",
                    "oracle"

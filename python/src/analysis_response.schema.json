{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R102 analysis response v2.0",
  "type": "object",
  "properties": {
    "response_schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "decision": {
      "type": "string",
      "enum": [
        "NO_TRADE",
        "WATCH",
        "LONG",
        "SHORT"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "thesis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entry_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "invalidation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "limiting_data": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "compatibility_contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/contract"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "response_schema_version",
    "execution_authorized",
    "decision",
    "confidence",
    "thesis",
    "entry_conditions",
    "invalidation",
    "limiting_data",
    "compatibility_contract"
  ],
  "additionalProperties": false,

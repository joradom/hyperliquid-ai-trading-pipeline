    "unresolved": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "entry",
            "invalidation",
            "quality"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "unsupported_predicate",
            "new_policy_required",
            "missing_snapshot_data",
            "temporal_evidence_required",
            "ambiguous_condition"
          ]
        },
        "threshold_origin": {
          "type": "string",

            "rule_id",
            "field",
            "predicate_type",
            "threshold",
            "range",
            "reference_source",
            "threshold_origin",
            "derivation",
            "purpose",
            "required_for_valid",
            "baseline_field",
            "atr_field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rule_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "field": {
              "type": "string",
              "enum": [
                "l2_midpoint",

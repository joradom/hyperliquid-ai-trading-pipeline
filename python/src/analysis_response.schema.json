            },
            "threshold": {
              "type": "null"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "reference_source": {
              "$ref": "#/$defs/reference"
            },
            "threshold_origin": {
              "type": "string",
              "enum": [
                "model_derived_from_snapshot",
                "pre_analysis_policy",
                "explicit_snapshot_level",
                "user_policy",
                "unsupported"
              ]
            },
            "derivation": {
              "type": "string",
              "enum": [
                "identity",
                "ordered_range",
                "snapshot_distance_atr"
              ]
            },
            "purpose": {
              "type": "string",
              "enum": [
                "entry",
                "invalidation",
                "quality"
              ]
            },
            "required_for_valid": {
